# Secure Books Direct-to-Outlook Submission Portal Environment Configuration

# Application Environment
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://www.securebooks.co.uk,https://securebooks.co.uk

# Microsoft Entra ID (Azure AD) Credentials
# Set these in production to authorize backend sending via Microsoft Graph API
MICROSOFT_TENANT_ID=your-azure-tenant-id-here
MICROSOFT_CLIENT_ID=your-azure-app-client-id-here
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret-here

# Target Mailbox Configuration
OUTLOOK_SENDER=info@securebooks.co.uk
OUTLOOK_RECIPIENT=info@securebooks.co.uk

# Upload & File Limits
MAX_FILE_SIZE_MB=25
MAX_TOTAL_UPLOAD_MB=100
TEMP_FILE_RETENTION_MINUTES=30
MALWARE_SCAN_ENABLED=true

# Mock Mode (Set to true for local testing without Azure credentials)
USE_MOCK_GRAPH=false
