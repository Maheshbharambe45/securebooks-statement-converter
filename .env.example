# Secure Books Client Documents Portal Environment Configuration

# Application Environment
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://forms.securebooks.co.uk
ALLOWED_ORIGINS=https://forms.securebooks.co.uk,https://www.securebooks.co.uk,https://securebooks.co.uk

# SMTP Mail Server Credentials
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=info@securebooks.co.uk
SMTP_PASSWORD=your-smtp-password-here

# Target Mailbox Configuration
MAIL_FROM=info@securebooks.co.uk
MAIL_TO=info@securebooks.co.uk

# Upload & File Limits
MAX_FILE_SIZE_MB=25
MAX_TOTAL_UPLOAD_MB=100
MAX_FILES_PER_CATEGORY=20
MAX_FILES_PER_SUBMISSION=50
MAX_CONCURRENT_UPLOADS=5
EMAIL_CONCURRENCY=2
TEMP_FILE_RETENTION_MINUTES=30
MALWARE_SCAN_ENABLED=true
